# --- GCP project (required) ---
GCP_PROJECT=your-gcp-project-id
GCP_REGION=europe-west1

# Vertex AI model location — defaults to 'global'.
# Some models only resolve from global even when the project is regional.
VERTEX_LOCATION=global

# --- Agent model (optional) ---
# Default: gemini-2.5-flash. Change to gemini-2.5-pro for higher quality.
AGENT_MODEL=gemini-3.6-flash

# --- Google Cloud auth ---
# Option 1: Application Default Credentials (recommended for development)
#   Run: gcloud auth application-default login
#
# Option 2: Service account key (for CI/CD)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
